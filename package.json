{
  "name": "papermarket-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run tests/unit --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:all": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "token:mint": "tsx scripts/mint-token.ts",
    "api:smoke": "tsx scripts/api-smoke.ts",
    "digest:send": "tsx scripts/send-digest.ts",
    "users:prune": "tsx scripts/prune-unconfirmed-users.ts",
    "markets:drop-untraded": "tsx scripts/drop-untraded-markets.ts",
    "follows:backfill-openers": "tsx scripts/follow-opened-markets.ts",
    "jev:reference": "tsx scripts/measure-jev-reference.ts",
    "institutions:build": "NODE_OPTIONS=--max-old-space-size=4096 tsx scripts/build-institution-domains.ts",
    "auth:generate": "auth generate --config auth.config.ts --output src/db/auth-schema.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@better-auth/api-key": "^1.7.6",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/extensions": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "better-auth": "^1.7.6",
    "canvas-confetti": "^1.9.4",
    "d3-force": "^3.0.0",
    "drizzle-orm": "^0.45.3",
    "input-otp": "^1.5.0",
    "katex": "^0.18.9",
    "next": "16.4.5",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "resend": "^6.31.0",
    "swr": "^2.5.1",
    "umap-js": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@readme/openapi-parser": "^9.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "fast-check": "^4.10.2",
    "prettier": "3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "katex": "$katex"
  }
}
